      "changelog": {
        "description": "### Patch Changes\n\n- Add official author avatars and deterministic split, light, and dark registry media for plugin banners, overviews, and galleries.",
        "title": "Source Editor 0.1.2",
      },
      "minAppVersion": "0.1.0",
