{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://registry.lapis.md/schemas/catalog-index.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "generatedAt",
    "registries",
    "plugins",
    "signatures"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "generatedAt": { "type": "string", "format": "date-time" },
    "registries": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lapis-official"],
      "properties": {
        "lapis-official": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "trustTier"],
          "properties": {
            "name": { "type": "string" },
            "trustTier": { "const": "official" }
          }
        }
      }
    },
    "plugins": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "schemaVersion",
          "id",
          "name",
          "description",
          "author",
          "channel",
          "status",
          "latestVersion",
          "minAppVersion",
          "platforms",
          "categories",
          "badges",
          "owner",
          "detail",
          "contributes"
        ],
        "properties": {
          "schemaVersion": { "const": 1 },
          "id": { "type": "string" },
          "name": { "type": "string" },
          "description": { "type": "string" },
          "readmeUrl": { "type": "string", "pattern": "^https://.+" },
          "author": { "type": "string" },
          "authorUrl": { "type": "string" },
          "appearance": {
            "$ref": "plugin-media.schema.json#/$defs/appearance"
          },
          "channel": { "enum": ["official", "community"] },
          "status": { "enum": ["active", "pending", "revoked"] },
          "latestVersion": { "type": "string" },
          "minAppVersion": { "type": "string" },
          "platforms": {
            "type": "array",
            "items": { "enum": ["web", "electron"] }
          },
          "categories": {
            "type": "array",
            "items": { "type": "string" }
          },
          "badges": {
            "type": "array",
            "items": { "type": "string" }
          },
          "owner": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "verified"],
            "properties": {
              "name": { "type": "string" },
              "verified": { "type": "boolean" },
              "url": { "type": "string", "pattern": "^https://.+" }
            }
          },
          "latestRelease": {
            "type": "object",
            "additionalProperties": false,
            "required": ["releasedAt", "bundleSize"],
            "properties": {
              "releasedAt": { "type": "string", "format": "date-time" },
              "bundleSize": { "type": "integer", "minimum": 0 }
            }
          },
          "detail": { "type": "string" },
          "contributes": { "type": "object" }
        }
      }
    },
    "signatures": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "signed-envelope.schema.json" }
    }
  }
}
