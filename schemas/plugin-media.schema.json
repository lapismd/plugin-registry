{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://registry.lapis.md/schemas/plugin-media.schema.json",
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "imageReference": {
      "type": "object",
      "required": [
        "url",
        "sourceUrl",
        "sha256",
        "size",
        "mediaType",
        "width",
        "height"
      ],
      "properties": {
        "url": { "type": "string", "pattern": "^https://.+" },
        "sourceUrl": { "type": "string", "pattern": "^https://.+" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "size": { "type": "integer", "minimum": 1, "maximum": 5242880 },
        "mediaType": {
          "enum": ["image/png", "image/webp", "image/svg+xml"]
        },
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 }
      }
    },
    "logoReference": {
      "type": "object",
      "unevaluatedProperties": false,
      "allOf": [
        { "$ref": "#/$defs/imageReference" },
        {
          "type": "object",
          "required": ["alt"],
          "properties": {
            "alt": { "type": "string", "minLength": 1, "maxLength": 120 }
          }
        }
      ]
    },
    "appearance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["icon", "accent"],
      "properties": {
        "icon": {
          "enum": [
            "bookmark",
            "file-code-2",
            "file-text",
            "history",
            "list-checks",
            "network",
            "package",
            "presentation",
            "search",
            "sparkles",
            "spell-check-2",
            "table-2",
            "whole-word"
          ]
        },
        "accent": { "type": "string", "pattern": "^#[A-Fa-f0-9]{6}$" },
        "logo": { "$ref": "#/$defs/logoReference" }
      }
    },
    "galleryItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "alt", "images"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{0,31}$"
        },
        "alt": { "type": "string", "minLength": 1, "maxLength": 240 },
        "images": {
          "type": "object",
          "additionalProperties": false,
          "required": ["preview", "full"],
          "properties": {
            "preview": { "$ref": "#/$defs/previewImageReference" },
            "full": { "$ref": "#/$defs/fullImageReference" }
          }
        }
      }
    },
    "previewImageReference": {
      "type": "object",
      "unevaluatedProperties": false,
      "allOf": [
        { "$ref": "#/$defs/imageReference" },
        {
          "type": "object",
          "properties": {
            "mediaType": { "const": "image/webp" },
            "width": { "const": 1200 },
            "height": { "const": 800 }
          }
        }
      ]
    },
    "fullImageReference": {
      "type": "object",
      "unevaluatedProperties": false,
      "allOf": [
        { "$ref": "#/$defs/imageReference" },
        {
          "type": "object",
          "properties": {
            "mediaType": { "const": "image/webp" },
            "width": { "const": 2400 },
            "height": { "const": 1600 }
          }
        }
      ]
    },
    "gallery": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "items": { "$ref": "#/$defs/galleryItem" }
    }
  }
}
