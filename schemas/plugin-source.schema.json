{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://registry.lapis.md/schemas/plugin-source.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "categories", "highlights", "content"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "categories": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z0-9-]+$" }
    },
    "highlights": {
      "type": "array",
      "maxItems": 8,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 160 }
    },
    "documentationUrl": { "$ref": "#/$defs/httpsUrl" },
    "appearance": { "$ref": "#/$defs/sourceAppearance" },
    "gallery": { "$ref": "#/$defs/sourceGallery" },
    "content": {
      "type": "object",
      "additionalProperties": false,
      "required": ["overview", "changelog"],
      "properties": {
        "overview": { "$ref": "#/$defs/safeRelativePath" },
        "changelog": { "$ref": "#/$defs/safeRelativePath" }
      }
    }
  },
  "$defs": {
    "httpsUrl": {
      "type": "string",
      "pattern": "^https://.+"
    },
    "safeRelativePath": {
      "type": "string",
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]+\\.md$"
    },
    "safeAssetPath": {
      "type": "string",
      "pattern": "^registry-assets/(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]+\\.(?:png|webp|svg)$"
    },
    "safeGalleryAssetPath": {
      "type": "string",
      "pattern": "^registry-assets/gallery/[a-z0-9][a-z0-9-]*\\.(?:preview|full)\\.webp$"
    },
    "iconName": {
      "enum": [
        "bookmark",
        "file-code-2",
        "file-text",
        "history",
        "list-checks",
        "network",
        "package",
        "presentation",
        "search",
        "sparkles",
        "spell-check-2",
        "table-2",
        "whole-word"
      ]
    },
    "sourceAppearance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["icon", "accent"],
      "properties": {
        "icon": { "$ref": "#/$defs/iconName" },
        "accent": { "type": "string", "pattern": "^#[A-Fa-f0-9]{6}$" },
        "logo": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "alt"],
          "properties": {
            "path": { "$ref": "#/$defs/safeAssetPath" },
            "alt": { "type": "string", "minLength": 1, "maxLength": 120 }
          }
        }
      }
    },
    "sourceGallery": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "alt", "images", "capture", "card"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,31}$"
          },
          "alt": { "type": "string", "minLength": 1, "maxLength": 240 },
          "images": {
            "type": "object",
            "additionalProperties": false,
            "required": ["preview", "full"],
            "properties": {
              "preview": {
                "$ref": "#/$defs/sourceGalleryImage"
              },
              "full": {
                "$ref": "#/$defs/sourceGalleryImage"
              }
            }
          },
          "capture": {
            "type": "object",
            "additionalProperties": false,
            "required": ["storyId", "focus"],
            "properties": {
              "storyId": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9-]*--[a-z0-9-]+$"
              },
              "focus": {
                "oneOf": [
                  {
                    "enum": [
                      "full-shell",
                      "left-sidebar",
                      "right-sidebar",
                      "bottom-status"
                    ]
                  },
                  { "$ref": "#/$defs/normalizedCrop" }
                ]
              }
            }
          },
          "card": {
            "type": "object",
            "additionalProperties": false,
            "required": ["headline", "description"],
            "properties": {
              "headline": {
                "type": "array",
                "minItems": 1,
                "maxItems": 4,
                "items": { "$ref": "#/$defs/headlineSegment" }
              },
              "description": {
                "type": "array",
                "minItems": 1,
                "maxItems": 6,
                "items": { "$ref": "#/$defs/descriptionSegment" }
              }
            }
          }
        }
      }
    },
    "sourceGalleryImage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path"],
      "properties": {
        "path": { "$ref": "#/$defs/safeGalleryAssetPath" }
      }
    },
    "normalizedCrop": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "width", "height"],
      "properties": {
        "x": { "type": "number", "minimum": 0, "maximum": 1 },
        "y": { "type": "number", "minimum": 0, "maximum": 1 },
        "width": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
        "height": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 }
      }
    },
    "headlineSegment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "tone"],
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60,
          "pattern": "^[^#*`<>]+$"
        },
        "tone": {
          "enum": ["neutral", "violet", "cyan", "green", "amber", "rose"]
        }
      }
    },
    "descriptionSegment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "tone"],
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "pattern": "^[^#*`<>]+$"
        },
        "tone": {
          "enum": ["neutral", "violet", "cyan", "green", "amber", "rose"]
        }
      }
    }
  }
}
