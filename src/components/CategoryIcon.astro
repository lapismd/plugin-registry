---
import {
  BadgeCheck,
  Blocks,
  Check,
  Database,
  FileText,
  Globe,
  LayoutDashboard,
  Monitor,
  Network,
  NotebookTabs,
  Package,
  Pencil,
  Presentation,
  Search,
  ShieldCheck,
  SlidersHorizontal,
  Sparkles,
  SquareDashedMousePointer,
  Wrench,
  Zap,
} from "@lucide/astro";

interface Props {
  id?: string;
  size?: number;
  selected?: boolean;
}

const { id = "package", size = 15, selected = false } = Astro.props;

const icons = {
  active: BadgeCheck,
  all: SlidersHorizontal,
  automation: Zap,
  canvas: SquareDashedMousePointer,
  database: Database,
  "developer-tools": Wrench,
  diagnostics: SlidersHorizontal,
  documents: FileText,
  editor: Pencil,
  desktop: Monitor,
  graph: Network,
  markdown: FileText,
  notebook: NotebookTabs,
  official: ShieldCheck,
  organization: LayoutDashboard,
  package: Package,
  pending: Sparkles,
  presentation: Presentation,
  revoked: ShieldCheck,
  search: Search,
  themes: Blocks,
  verified: BadgeCheck,
  viewer: FileText,
  visualization: Network,
  web: Globe,
};

const Icon = selected ? Check : icons[id as keyof typeof icons] ?? Package;
const iconSize = selected ? 12 : size;
const strokeWidth = selected ? 3 : 2;
---

<Icon size={iconSize} stroke-width={strokeWidth} aria-hidden="true" />
