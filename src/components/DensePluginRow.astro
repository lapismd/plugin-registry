---
import { formatBytes, type SitePlugin } from "../lib/registry-data";
import PluginIdentity from "./PluginIdentity.astro";

interface Props {
  plugin: SitePlugin;
  as?: "a" | "article";
  popularCandidate?: boolean;
}

const { plugin, as = "a", popularCandidate = false } = Astro.props as Props;
const primaryCategory = plugin.categories[0] ?? "package";
const href = `/plugins/${plugin.id}/`;
---

{
  as === "article" ? (
    <article
      class="dense-plugin-row"
      data-popular-item={popularCandidate || undefined}
      data-plugin-id={popularCandidate ? plugin.id : undefined}
      data-plugin-name={popularCandidate ? plugin.name : undefined}
    >
      <PluginIdentity appearance={plugin.appearance} fallbackIcon={primaryCategory} size="compact" />
        <span class="dense-plugin-row__body">
          <span class="dense-plugin-row__title">{plugin.name}</span>
          <span class="dense-plugin-row__description">
            {plugin.description} · {formatBytes(plugin.latestRelease.bundle.size)}
            <span data-download-count data-plugin-id={plugin.id} hidden></span>
          </span>
        </span>
    </article>
  ) : (
    <a
      class="dense-plugin-row"
      href={href}
      data-popular-item={popularCandidate || undefined}
      data-plugin-id={popularCandidate ? plugin.id : undefined}
      data-plugin-name={popularCandidate ? plugin.name : undefined}
    >
      <PluginIdentity appearance={plugin.appearance} fallbackIcon={primaryCategory} size="compact" />
        <span class="dense-plugin-row__body">
          <span class="dense-plugin-row__title">{plugin.name}</span>
          <span class="dense-plugin-row__description">
            {plugin.description} · {formatBytes(plugin.latestRelease.bundle.size)}
            <span data-download-count data-plugin-id={plugin.id} hidden></span>
          </span>
        </span>
    </a>
  )
}
