---
import { Command, Search } from "@lucide/astro";
import { type SitePlugin } from "../lib/registry-data";
import PluginIdentity from "./PluginIdentity.astro";

interface Props {
  plugins: SitePlugin[];
}

const { plugins } = Astro.props;
const searchData = plugins.map((plugin) => ({
  id: plugin.id,
  name: plugin.name,
  description: plugin.description,
  categories: plugin.categories,
  platforms: plugin.platforms,
  filePatterns: plugin.filePatterns,
  searchText: plugin.searchText,
  href: `/plugins/${plugin.id}/`,
}));
---

<div class="command-search" data-command-root>
  <form class="site-search" action="/plugins/" role="search" autocomplete="off">
    <Search size={16} stroke-width="2" aria-hidden="true" />
    <input
      type="search"
      name="q"
      placeholder="Search plugins..."
      aria-label="Search plugins"
      data-command-input
    />
    <span class="command-kbd" aria-hidden="true">
      <Command size={12} stroke-width="2" />
      K
    </span>
  </form>
  <div class="command-results" data-command-results hidden>
    {
      plugins.map((plugin) => (
        <a
          class="command-result"
          href={`/plugins/${plugin.id}/`}
          data-command-result
          data-search-text={plugin.searchText}
        >
          <PluginIdentity appearance={plugin.appearance} fallbackIcon={plugin.categories[0]} size="compact" />
          <span class="command-result__body">
            <span class="command-result__title">{plugin.name}</span>
            <span class="command-result__description">{plugin.description}</span>
          </span>
        </a>
      ))
    }
    <p class="command-empty" data-command-empty hidden>No plugins found.</p>
  </div>
  <script
    type="application/json"
    data-command-data
    is:inline
    set:html={JSON.stringify(searchData)}
  ></script>
</div>

<script>
  const commandRoots = document.querySelectorAll<HTMLElement>("[data-command-root]");

  for (const root of commandRoots) {
    const input = root.querySelector<HTMLInputElement>("[data-command-input]");
    const resultsPanel = root.querySelector<HTMLElement>("[data-command-results]");
    const emptyState = root.querySelector<HTMLElement>("[data-command-empty]");
    const resultLinks = [
      ...root.querySelectorAll<HTMLAnchorElement>("[data-command-result]"),
    ];
    const params = new URLSearchParams(window.location.search);
    const initialQuery = params.get("q");

    if (input && initialQuery) {
      input.value = initialQuery;
    }

    function applyCommandResults() {
      const query = (input?.value || "").trim().toLowerCase();
      let visible = 0;

      for (const link of resultLinks) {
        const matches =
          !query || (link.dataset.searchText || "").includes(query);
        const shouldShow = matches && visible < 7;
        link.toggleAttribute("hidden", !shouldShow);
        if (shouldShow) {
          visible += 1;
        }
      }

      emptyState?.toggleAttribute("hidden", visible !== 0);
      resultsPanel?.toggleAttribute("hidden", document.activeElement !== input);
    }

    input?.addEventListener("focus", applyCommandResults);
    input?.addEventListener("input", () => {
      applyCommandResults();
      window.dispatchEvent(
        new CustomEvent("lapis-plugin-search", {
          detail: { query: input.value },
        }),
      );
    });

    input?.form?.addEventListener("submit", (event) => {
      const query = (input.value || "").trim().toLowerCase();
      const exact = resultLinks.find(
        (link) =>
          link
            .querySelector(".command-result__title")
            ?.textContent?.trim()
            .toLowerCase() === query,
      );
      if (exact) {
        event.preventDefault();
        window.location.href = exact.href;
      }
    });

    document.addEventListener("keydown", (event) => {
      if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === "k") {
        event.preventDefault();
        input?.focus();
      }
      if (event.key === "Escape") {
        resultsPanel?.setAttribute("hidden", "");
        input?.blur();
      }
    });

    document.addEventListener("click", (event) => {
      if (!(event.target instanceof Node) || !root.contains(event.target)) {
        resultsPanel?.setAttribute("hidden", "");
      }
    });
  }
</script>
