---
import SearchPalette from "../components/SearchPalette.astro";
import { getRegistrySiteData } from "../lib/registry-data";
import "../styles/site.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Lapis Plugin Registry",
  description = "Signed plugin registry for Lapis Notes.",
} = Astro.props;
const { plugins } = await getRegistrySiteData();
const isLandingPage = Astro.url.pathname === "/";
const currentYear = new Date().getUTCFullYear();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{title}</title>
  </head>
  <body>
    <div class="site-shell">
      <header class:list={["site-header", isLandingPage && "site-header--landing"]}>
        <a class="site-brand" href="/" aria-label="Lapis Plugin Registry">
          <img src="/lapis-logo.svg" alt="" aria-hidden="true" />
          <span>Lapis</span>
        </a>
        <SearchPalette plugins={plugins} />
        <nav class="site-actions" aria-label="Primary">
          <a href="/plugins/">Plugins</a>
          <a href="/v1/index.json">Manifest</a>
        </nav>
      </header>
      <slot />
      <footer class="site-footer">
        <div class="site-footer__inner">
          <div class="site-footer__brand-column">
            <a class="site-footer__brand" href="/" aria-label="Lapis Plugin Registry home">
              <img src="/lapis-logo.svg" alt="" aria-hidden="true" />
              <span>
                <strong>Lapis</strong>
                <small>Plugin Registry</small>
              </span>
            </a>
            <p>Signed community software for Lapis Notes.</p>
            <p class="site-footer__copyright">© {currentYear} LapisMD</p>
          </div>
          <nav class="site-footer__directory" aria-label="Footer">
            <section>
              <h2>Registry</h2>
              <a href="/plugins/">Browse plugins</a>
              <a href="/v1/index.json">Registry manifest</a>
              <a href="/v1/trust/root.json">Trust root</a>
              <a href="/stats/summary.json">Download statistics</a>
            </section>
            <section>
              <h2>Developers</h2>
              <a href="https://github.com/lapismd/plugin-registry/blob/main/docs/publishing.md">Publishing guide</a>
              <a href="https://github.com/lapismd/plugin-registry/tree/main/schemas">Registry schemas</a>
              <a href="https://github.com/lapismd/lapis-plugins">First-party plugins</a>
              <a href="https://github.com/lapismd/plugin-registry">Registry source</a>
            </section>
            <section>
              <h2>Project</h2>
              <a href="https://github.com/lapismd/lapis-notes">Lapis Notes</a>
              <a href="https://github.com/lapismd/lapis-notes/releases">Releases</a>
              <a href="https://github.com/lapismd/lapis-notes/issues">Issues</a>
              <a href="https://github.com/lapismd">LapisMD on GitHub</a>
            </section>
          </nav>
        </div>
      </footer>
    </div>
    <script is:inline type="module" src="/download-stats.js"></script>
  </body>
</html>
