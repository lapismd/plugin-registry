---
import CategoryIcon from "../components/CategoryIcon.astro";
import DensePluginRow from "../components/DensePluginRow.astro";
import SiteLayout from "../layouts/SiteLayout.astro";
import { getRegistrySiteData } from "../lib/registry-data";

const { plugins, categories, generatedAt } = await getRegistrySiteData();
const pendingPlugins = plugins.filter((plugin) => plugin.status === "pending");
const recentlyUpdated = [...plugins].sort((a, b) =>
  b.latestRelease.releasedAt.localeCompare(a.latestRelease.releasedAt),
);
const generatedDate = new Date(generatedAt).toLocaleDateString("en-GB");
---

<SiteLayout
  title="Lapis Plugin Registry"
  description="Browse signed official plugins for Lapis Notes."
>
  <main class="page-main">
    <section class="home-hero">
      <h1>Lapis Plugin Registry</h1>
      <p>Browse {plugins.length} official plugins built for Lapis Notes.</p>
    </section>

    <section class="home-directory-grid" aria-label="Registry directory">
      <div class="directory-column">
        <div class="section-heading">
          <h2>Plugins</h2>
          <a href="/plugins/">View all</a>
        </div>
        <div class="dense-list">
          {plugins.slice(0, 5).map((plugin) => <DensePluginRow plugin={plugin} />)}
        </div>
      </div>

      <div class="directory-column">
        <div class="section-heading">
          <h2>Coming soon</h2>
          <a href="/plugins/?status=pending">View all</a>
        </div>
        <div class="dense-list">
          {
            pendingPlugins
              .slice(0, 5)
              .map((plugin) => <DensePluginRow plugin={plugin} />)
          }
        </div>
      </div>

      <div class="directory-column">
        <div class="section-heading">
          <h2>Categories</h2>
          <span class="text-link">Generated {generatedDate}</span>
        </div>
        <div class="dense-list">
          {
            categories.slice(0, 5).map((category) => (
              <a
                class="dense-plugin-row"
                href={`/plugins/?categories=${category.id}`}
              >
                <span class="plugin-icon plugin-icon--compact">
                  <CategoryIcon id={category.id} size={18} />
                </span>
                <span class="dense-plugin-row__body">
                  <span class="dense-plugin-row__title">{category.label}</span>
                  <span class="dense-plugin-row__description">
                    {category.count} official plugin{category.count === 1 ? "" : "s"}
                  </span>
                </span>
              </a>
            ))
          }
        </div>
      </div>
    </section>

    <section class="directory-section">
      <div class="section-heading">
        <h2>Recently updated</h2>
        <a href="/plugins/">Browse registry</a>
      </div>
      <div class="dense-list dense-list--wide">
        {
          recentlyUpdated
            .slice(0, 5)
            .map((plugin) => <DensePluginRow plugin={plugin} />)
        }
      </div>
    </section>
  </main>
</SiteLayout>
