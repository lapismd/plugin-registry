---
import { ChevronRight } from "@lucide/astro";
import CategoryIcon from "../components/CategoryIcon.astro";
import DensePluginRow from "../components/DensePluginRow.astro";
import SiteLayout from "../layouts/SiteLayout.astro";
import { getRegistrySiteData } from "../lib/registry-data";

const { plugins, categories } = await getRegistrySiteData();
const activePlugins = plugins.filter((plugin) => plugin.status === "active");
const recentlyUpdated = [...plugins].sort((a, b) =>
  b.latestRelease.releasedAt.localeCompare(a.latestRelease.releasedAt),
);
const newlyReleased = [...plugins].sort((a, b) =>
  b.firstReleasedAt.localeCompare(a.firstReleasedAt),
);
---

<SiteLayout
  title="Lapis Plugin Registry"
  description="Browse signed official plugins for Lapis Notes."
>
  <main class="page-main page-main--home">
    <section class="home-hero">
      <h1>Make Lapis Notes yours.</h1>
      <p>Browse {plugins.length} plugins built for Lapis Notes by the community.</p>
    </section>

    <section class="home-section" aria-labelledby="home-plugins-heading">
      <h2 class="home-section-title" id="home-plugins-heading">
        <a href="/plugins/">
          <span>Plugins</span>
          <ChevronRight size={24} stroke-width="2" aria-hidden="true" />
        </a>
      </h2>

      <div class="home-directory-grid home-discovery-grid">
        <div class="directory-column" data-popular-lane aria-busy="false">
          <h3 class="home-lane-heading">
            <a href="/plugins/?sort=popular">
              <span>Popular</span>
              <ChevronRight size={16} stroke-width="2" aria-hidden="true" />
            </a>
          </h3>
          <div class="dense-list home-plugin-list home-popular-list" data-popular-list>
            {
              activePlugins.map((plugin) => (
                <DensePluginRow plugin={plugin} popularCandidate home />
              ))
            }
          </div>
        </div>

        <div class="directory-column">
          <h3 class="home-lane-heading">
            <a href="/plugins/?sort=new">
              <span>New</span>
              <ChevronRight size={16} stroke-width="2" aria-hidden="true" />
            </a>
          </h3>
          <div class="dense-list home-plugin-list">
            {
              newlyReleased
                .slice(0, 5)
                .map((plugin) => <DensePluginRow plugin={plugin} home />)
            }
          </div>
        </div>

        <div class="directory-column">
          <h3 class="home-lane-heading">
            <a href="/plugins/?sort=updated">
              <span>Updated</span>
              <ChevronRight size={16} stroke-width="2" aria-hidden="true" />
            </a>
          </h3>
          <div class="dense-list home-plugin-list">
            {
              recentlyUpdated
                .slice(0, 5)
                .map((plugin) => <DensePluginRow plugin={plugin} home />)
            }
          </div>
        </div>
      </div>
    </section>

    <section class="home-section home-categories" aria-labelledby="home-categories-heading">
      <h2 class="home-section-title" id="home-categories-heading">
        <a href="/plugins/">
          <span>Categories</span>
          <ChevronRight size={24} stroke-width="2" aria-hidden="true" />
        </a>
      </h2>
      <div class="home-category-grid">
        {
          categories.slice(0, 8).map((category) => (
            <a
              class="home-category-card"
              href={`/plugins/?categories=${category.id}`}
              aria-label={`${category.label}, ${category.count} plugin${category.count === 1 ? "" : "s"}`}
            >
              <CategoryIcon id={category.id} size={24} />
              <span class="home-category-card__label">{category.label}</span>
              <span class="home-category-card__count">{category.count}</span>
            </a>
          ))
        }
      </div>
    </section>
  </main>
</SiteLayout>
