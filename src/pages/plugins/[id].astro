---
import PluginDetailPage from "../../components/PluginDetailPage.astro";
import { getRegistrySiteData } from "../../lib/registry-data";

export async function getStaticPaths() {
  const { plugins } = await getRegistrySiteData();
  return plugins.map((plugin) => ({ params: { id: plugin.id }, props: { pluginId: plugin.id } }));
}
---
<PluginDetailPage pluginId={Astro.props.pluginId} />
